{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "fundamental-ui-registry-react",
  "homepage": "https://github.com/adrianhdezm/fundamental-ui-registry/tree/main/packages/react",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn() and variants",
      "description": "Class name merging (clsx + tailwind-merge, aware of the SAP token utilities) and cva variants.",
      "dependencies": ["clsx", "tailwind-merge", "class-variance-authority"],
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:style",
      "title": "SAP Horizon theme",
      "description": "SAP theme tokens for Tailwind v4: Horizon, Horizon Dark, Horizon HC Black and Horizon HC White, the 72 and SAP icon fonts, density and state variants.",
      "files": [
        {
          "path": "registry/styles/fundamental.css",
          "type": "registry:file",
          "target": "src/styles/fundamental.css"
        },
        {
          "path": "registry/styles/tokens.css",
          "type": "registry:file",
          "target": "src/styles/tokens.css"
        },
        {
          "path": "registry/styles/extensions.css",
          "type": "registry:file",
          "target": "src/styles/extensions.css"
        },
        {
          "path": "registry/styles/fonts.css",
          "type": "registry:file",
          "target": "src/styles/fonts.css"
        },
        {
          "path": "registry/styles/themes/sap_horizon.css",
          "type": "registry:file",
          "target": "src/styles/themes/sap_horizon.css"
        },
        {
          "path": "registry/styles/themes/sap_horizon_dark.css",
          "type": "registry:file",
          "target": "src/styles/themes/sap_horizon_dark.css"
        },
        {
          "path": "registry/styles/themes/sap_horizon_hcb.css",
          "type": "registry:file",
          "target": "src/styles/themes/sap_horizon_hcb.css"
        },
        {
          "path": "registry/styles/themes/sap_horizon_hcw.css",
          "type": "registry:file",
          "target": "src/styles/themes/sap_horizon_hcw.css"
        }
      ],
      "css": {
        "@import \"./styles/fundamental.css\"": {}
      }
    }
  ]
}
