{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "registry",
  "cli": { "packageManager": "pnpm", "analytics": false },
  "projects": {
    "ui": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "registry/angular",
      "prefix": "fd",
      "architect": {
        "storybook": {
          "builder": "@analogjs/storybook-angular:start-storybook",
          "options": {
            "configDir": ".storybook/angular",
            "tsConfig": ".storybook/angular/tsconfig.json",
            "styles": [".storybook/angular/styles.css"],
            "experimentalZoneless": true,
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@analogjs/storybook-angular:build-storybook",
          "options": {
            "configDir": ".storybook/angular",
            "tsConfig": ".storybook/angular/tsconfig.json",
            "styles": [".storybook/angular/styles.css"],
            "experimentalZoneless": true,
            "compodoc": false,
            "outputDir": "dist/storybook"
          }
        }
      }
    }
  }
}
