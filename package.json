{
  "name": "fundamental-ngx-registry",
  "version": "0.0.0",
  "private": true,
  "description": "SAP Fiori Horizon components for Angular and React, styled with Tailwind CSS. Copy the source into your app, shadcn-style.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "storybook": "pnpm registry:build && pnpm run \"/^storybook:/\"",
    "storybook:angular": "ng run ui:storybook",
    "storybook:react": "storybook dev -c .storybook/react -p 6007 --no-open",
    "build-storybook": "pnpm registry:build && ng run ui:build-storybook && storybook build -c .storybook/react -o dist/storybook/react",
    "typecheck": "ngc -p registry/angular/tsconfig.json --noEmit && tsc -p registry/react/tsconfig.json",
    "typecheck:tests": "ngc -p tests/angular/tsconfig.json --noEmit && tsc -p tests/react/tsconfig.json --noEmit && tsc -p .storybook/react/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:styles": "node scripts/check-styles.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm check:styles && pnpm registry:check && pnpm test && pnpm test:a11y",
    "test": "vitest run --project angular --project react",
    "test:watch": "vitest --project angular --project react",
    "test:a11y": "node --max-old-space-size=6144 node_modules/vitest/vitest.mjs run --project a11y:angular:sap_horizon && node --max-old-space-size=6144 node_modules/vitest/vitest.mjs run --project a11y:angular:sap_horizon_hcb && vitest run --project \"a11y:react:*\""
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "^2.9.2",
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@sap-theming/theming-base-content": "11.36.5",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/angular": "^10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "remark-gfm": "4.0.1",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "type": "module"
}
